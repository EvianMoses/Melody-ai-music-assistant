__pycache__/
*.pyc
venv/
.venv/
.env
# Any local variant (.env.local, .env.backup-*, …) may hold real secrets.
# The secret-free template is re-included below.
.env.*
!.env.example
prep_files/.spotify_refresh_token
*.zip
.DS_Store
.cursor/
.vscode/
*.cursorrules
.cache
# ---------------------------------------------------------------------------
# Datasets are NOT distributed with this repository (see data/README.md).
#
# Two reasons: the curated genre corpus in data/genres_knowledge/ is a project
# asset and is not published, and the review datasets are third-party text that
# does not need redistributing from a public repo. History was rewritten on
# 2026-07-28 to remove them from every past commit, so re-adding one here would
# quietly undo that.
#
# The structure and the format samples ARE tracked, so the ingestion scripts
# stay readable and testable without the data.
# ---------------------------------------------------------------------------
data/**
!data/README.md
!data/samples/
!data/samples/**

# ~~Phase 6 §6.3 — GTZAN training data (~1.2 GB, downloaded by ml/dataset.py).~~
# Superseded by the blanket data/** rule above; kept as a note because the
# reason still holds independently — GTZAN is 1.2 GB and re-downloadable.
# data/gtzan/

# Trained model checkpoints. The training run is reproducible from
# ml/train.py; binaries do not belong in the repository.
audio-service/ml/checkpoints/*.pt
audio-service/ml/checkpoints/*.pth

# Python build artifacts (editable installs regenerate these).
*.egg-info/
