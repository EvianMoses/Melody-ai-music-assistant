# Flask
FLASK_SECRET_KEY=

# AWS Bedrock (legacy path — keep intact during n8n cutover)
BEDROCK_AGENT_ID=
BEDROCK_AGENT_ALIAS_ID=
AWS_DEFAULT_REGION=us-east-2
# Needed only to run REC-LEG-001/002 (or the legacy /chat path) from a machine
# without an IAM instance role, e.g. a local dev box. python-dotenv loads these
# into the process env and boto3 picks them up automatically — no code change
# needed. Leave AWS_SESSION_TOKEN blank for long-term IAM user keys; fill it in
# only if using temporary/SSO credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Spotify OAuth
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=
SPOTIPY_REDIRECT_URI=

# YouTube Data API v3 (Phase 5 §5.1/§5.3, direct mode, ADR-002). Search-only for
# now — an API key from a Google Cloud project with the YouTube Data API v3
# enabled is enough (no OAuth consent screen needed). Read by provider-gateway.
# search.list costs 100 quota units/call against a 10,000/day default quota.
YOUTUBE_API_KEY=
# Region used for search bias and the availability check (§PROV-002). ISO 3166-1.
YOUTUBE_REGION=IL
# Track-length bounds in seconds. Outside this range a result is treated as a
# DJ mix / compilation and heavily deprioritized (§5.3).
YOUTUBE_MIN_TRACK_SECONDS=60
YOUTUBE_MAX_TRACK_SECONDS=600

# ---------------------------------------------------------------------------
# Google OAuth / OpenID Connect (Phase 5 §5.2, AUTH-001…006). Read by the Flask
# app. Setup, in the SAME Google Cloud project as YOUTUBE_API_KEY above:
#   1. OAuth consent screen → External, publishing status "Testing".
#      Add your own Google account under "Test users" — in Testing mode only
#      listed test users can sign in at all.
#   2. Credentials → Create credentials → OAuth client ID → Web application.
#   3. Authorized redirect URI, exact match, no trailing slash:
#        http://127.0.0.1:5000/auth/google/callback
#      (plain http is permitted only for localhost/127.0.0.1 loopback, and
#       Google treats "localhost" and "127.0.0.1" as different entries)
# Note: refresh tokens issued while the app is in "Testing" expire after 7 days
# — that is Google policy, not a bug in this code.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/auth/google/callback

# Encryption key(s) for OAuth tokens at rest (AUTH-006, ADR-007). Comma-separated:
# the FIRST key encrypts, ANY key decrypts, which is how rotation works — prepend
# a new key and keep the old one until existing rows are re-encrypted.
# Generate:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ⚠️ BACKUP-CRITICAL: losing this key makes every stored connection undecryptable
# and forces all users to reconnect. There is no plaintext fallback by design.
OAUTH_TOKEN_ENCRYPTION_KEY=

# n8n orchestrator (WF-001 Main Request Router)
# Must match the `path` on WF-001's Webhook node, which is "melody/route".
#   production (workflow activated): /webhook/melody/route
#   editor testing ("Execute workflow" first): /webhook-test/melody/route
N8N_WEBHOOK_URL=http://localhost:5678/webhook/melody/route
# Explicit HTTP timeout (seconds) for Flask → n8n calls
N8N_HTTP_TIMEOUT_SECONDS=120
# Feature flag for POST /api/v1/requests (true|false). Legacy /chat and /ask stay on Bedrock.
USE_N8N_ORCHESTRATOR=true

# ---------------------------------------------------------------------------
# Feature flags (ARC-004) — see docs/feature-flags.md for semantics and owners.
# Booleans accept 1|true|yes|on; anything else (including unset) is false.
# Defaults below are the SAFE values, not the demo values.
# ---------------------------------------------------------------------------
# Default recommendation engine: legacy (Bedrock Agent) | langgraph (new service).
RECOMMENDATION_ENGINE=legacy
# Permit the explicitly logged emergency fallback to Bedrock (Section 2.3).
ENABLE_LEGACY_BEDROCK_FALLBACK=false

# Provider mode, closed by ADR-002: direct | musicapi | hybrid.
PROVIDER_MODE=direct
# Spotify is limited to the 5 authorized development users.
ENABLE_SPOTIFY_ADAPTER=false
# Master switch for external provider writes (playlist creation). Enforced in
# provider-gateway/main.py since §5.5; until then it was declared but unread.
ENABLE_PLAYLIST_EXPORT=false
# Quota guard. playlists.insert costs 50 units and playlistItems.insert costs 50
# *per track*, against 10,000/day shared with search -- so a 10-track export is
# 550 units, about 18 exports/day. This cap stops one request burning the budget.
YOUTUBE_MAX_EXPORT_TRACKS=25
# private | unlisted | public. Exports are private by default: the playlist is
# created in a real person's account, so visibility is opt-in.
YOUTUBE_PLAYLIST_PRIVACY=private

# Recognition-provider call; stays off until ADR-004 selects a provider.
ENABLE_AUDIO_IDENTIFICATION=false
# P2 proofs of concept.
ENABLE_CLAP=false
ENABLE_CROSSFADE=false

# Budget kill switch: WF-008 sets this false at 95% of the monthly ceiling.
ENABLE_EXPENSIVE_MODEL_PATHS=true
# Must stay false in the submission environment (Phase 1 §1.14, INT-002).
ALLOW_PLACEHOLDER_NODES=false

# ---------------------------------------------------------------------------
# PostgreSQL + pgvector (docker-compose "postgres" service)
# ---------------------------------------------------------------------------
POSTGRES_USER=melody
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=melody
POSTGRES_PORT=5432

# Consumed by Alembic (migrations/env.py). Host-run migrations use localhost;
# a service running inside the compose network would use host "postgres".
# Uses the psycopg (v3) driver.
DATABASE_URL=postgresql+psycopg://melody:change_me_locally@localhost:5432/melody

# ---------------------------------------------------------------------------
# n8n container (protected editor + persistence)
# ---------------------------------------------------------------------------
# N8N_BASIC_AUTH_USER / N8N_BASIC_AUTH_PASSWORD were REMOVED (INF-002b).
# n8n dropped basic auth in 1.0 and this project runs 2.31.6, so those two
# variables did nothing at all -- they described a protection that was not
# there. Editor access is protected by n8n's own owner account (created once,
# in the browser, on first visit) plus the loopback bind below.
#
# Which host interface publishes the n8n editor. 127.0.0.1 keeps it reachable
# from this machine and from nowhere else. On the VPS, remove the port mapping
# in docker-compose.yml entirely -- Flask reaches n8n over the private network.
N8N_BIND_ADDRESS=127.0.0.1
# Stable secret used to encrypt stored n8n credentials; keep constant across restarts.
N8N_ENCRYPTION_KEY=change_me_to_a_long_random_string
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_WEBHOOK_BASE_URL=http://localhost:5678/

# ---------------------------------------------------------------------------
# Flask web container (INF-011). These apply only when Flask runs inside
# docker compose; `python app.py` on the host ignores them.
# ---------------------------------------------------------------------------
# Host interface + port for the web app. Loopback by default; the reverse proxy
# (DEP-002) is what faces the public on the VPS.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=5000
# Service names, not localhost: inside the network `localhost` is the web
# container itself. These override the host-oriented values above/below.
N8N_INTERNAL_WEBHOOK_URL=http://n8n:5678/webhook/melody/route
AUDIO_SERVICE_INTERNAL_URL=http://audio-service:8000

# ---------------------------------------------------------------------------
# Service ports (docker-compose)
#
# ~~OLLAMA_PORT=11434~~ — REMOVED 2026-07-28 with the `ollama` service itself.
# The local-model requirement is served by three models that run in-process on
# the request path (multilingual-e5-small and mmarco-mMiniLMv2 in rag-service,
# the PyTorch audio CNN in audio-service), none of which needs a port.
# ---------------------------------------------------------------------------
RECOMMENDATION_PORT=8001
RAG_PORT=8002
AUDIO_PORT=8003
GUARDRAILS_PORT=8004
PROVIDER_GATEWAY_PORT=8005

# ---------------------------------------------------------------------------
# Audio pipeline (Phase 6 §6.1). These are safety boundaries, not tuning knobs:
# widening one is a deliberate act. audio-service falls back to the documented
# default if a value is malformed -- a broken limit must never become an absent
# limit.
# ---------------------------------------------------------------------------
# Where Flask forwards uploaded clips. Flask holds no audio itself; the browser
# never learns this URL.
AUDIO_SERVICE_URL=http://localhost:8003
AUDIO_UPLOAD_TIMEOUT_SECONDS=90
# Server-side upload cap. 15 MiB holds a 30 s clip in any allowed format,
# including uncompressed WAV.
AUDIO_MAX_UPLOAD_BYTES=15728640
# We never analyse more than this, however long the upload is. A longer file is
# truncated rather than rejected, and the response says `truncated: true`.
AUDIO_MAX_DURATION_SECONDS=30
# `webm` and `mp4` are not optional: they are what a browser's MediaRecorder
# produces, so dropping them would break recording while looking correct.
AUDIO_ALLOWED_FORMATS=wav,mp3,flac,m4a,mp4,ogg,webm
# How long a stored clip may survive before the sweeper deletes it (AUD-UP-006).
AUDIO_RETENTION_MINUTES=15
# Approved temporary storage inside the container (a named docker volume).
AUDIO_STORAGE_DIR=/tmp/melody-audio

# ---------------------------------------------------------------------------
# ACRCloud recognition (Phase 6 §6.4, ADR-004). Without these, /audio/identify
# reports a stated gap -- it never invents a match.
#
# All THREE are required. The host is the part most often missed: ACRCloud
# issues a per-project regional endpoint, and pointing a valid key at the wrong
# region answers `3001 Missing/Invalid Access Key`, which is indistinguishable
# from a bad key. Find it in the ACRCloud console under your
# "Audio & Video Recognition" project, next to the access key.
#
# Expected shapes, worth checking against what you paste: the access key is 32
# characters and the secret is 40. Credentials of a different length usually
# come from a different product section (the Metadata API uses a bearer token,
# not this HMAC flow) and will be rejected no matter which host is set.
#
#   GET http://localhost:8003/audio/recognition/status
# reports which of the three are present, and their lengths, without revealing
# their values.
ACRCLOUD_HOST=
ACRCLOUD_ACCESS_KEY=
ACRCLOUD_ACCESS_SECRET=

# Heavy-model generation for the curator explanation (node 17, §4.8). The
# single bounded rewrite (node 11, §4.5) stays deterministic/rule-based for
# this phase of work -- a documented, deliberate narrowing of ADR-006's
# literal text; see the plan doc's session bookmark. Direct Anthropic API --
# no AWS IAM or region needed. The local Ollama model handles cheap
# classification/extraction instead.
ANTHROPIC_API_KEY=
HEAVY_MODEL=claude-haiku-4-5

# Internal service-to-service URLs inside the compose network (§4.2 nodes 5-13).
RAG_SERVICE_URL=http://rag-service:8000
PROVIDER_GATEWAY_URL=http://provider-gateway:8000
