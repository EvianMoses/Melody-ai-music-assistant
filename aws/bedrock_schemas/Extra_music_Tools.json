{
    "openapi": "3.0.0",
    "info": {
        "title": "ExtraMusicTools",
        "version": "1.0.0",
        "description": "Tools for fetching detailed information about musical artists."
    },
    "paths": {
        "/get-artist-info": {
            "get": {
                "summary": "Get Artist Info",
                "description": "Retrieves detailed information about a musical artist, including their biography, history, associated genres (tags), and similar artists.",
                "operationId": "GetArtistInfo",
                "parameters": [
                    {
                        "name": "artist_name",
                        "in": "query",
                        "description": "The precise name of the artist or band",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Detailed artist information",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "body": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
