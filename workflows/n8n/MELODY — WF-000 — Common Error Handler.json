    {
      "parameters": {
        "jsCode": "const out = [];\nfor (const item of $input.all()) {\n  const data = item.json || {};\n  const execution = data.execution || {};\n  const workflow = data.workflow || {};\n  const err = data.error || execution.error || {};\n  const message = err.message || data.message || 'Unknown error';\n  const name = err.name || 'Error';\n  const stack = err.stack || null;\n  const node = err.node || execution.lastNodeExecuted || null;\n  const nodeName = (node && typeof node === 'object') ? node.name : node;\n  const retryable = /timeout|etimedout|econnreset|econnrefused|network|socket hang up|rate.?limit|throttl|429|502|503|504|temporar/i.test(String(message));\n  out.push({\n    json: {\n      errorName: name,\n      errorMessage: String(message),\n      errorStack: stack,\n      nodeName: nodeName || null,\n      workflowId: workflow.id || null,\n      workflowName: workflow.name || null,\n      executionId: execution.id || null,\n      executionUrl: execution.url || null,\n      mode: execution.mode || null,\n      retryable: retryable,\n      alertRequired: !retryable,\n      receivedAt: new Date().toISOString(),\n      original: data,\n    },\n  });\n}\nreturn out;"
      },
      "id": "aba55499-ffe6-45c5-91ea-c93b8ff201be",
      "name": "Normalize Error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        96
      ]
    },
    {
      "parameters": {
        "jsCode": "function isSensitiveKey(key) {\n  const k = String(key).toLowerCase();\n  return k.includes('token') || k.includes('cookie') || k.includes('secret') || k.includes('password') || k.includes('authorization') || k === 'auth' || k === 'apikey' || k === 'api_key' || k === 'api-key' || k === 'x-api-key' || k === 'bearer' || k === 'session' || k === 'sessionid';\n}\nfunction redact(value) {\n  if (Array.isArray(value)) return value.map(redact);\n  if (value && typeof value === 'object') {\n    const result = {};\n    for (const key of Object.keys(value)) {\n      result[key] = isSensitiveKey(key) ? '[REDACTED]' : redact(value[key]);\n    }\n    return result;\n  }\n  return value;\n}\nreturn $input.all().map((item) => ({ json: redact(item.json) }));"
      },
