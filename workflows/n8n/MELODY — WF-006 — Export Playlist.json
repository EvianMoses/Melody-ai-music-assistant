      "name": "Create Playlist",
      "onError": "stopWorkflow"
    },
    {
      "parameters": {
        "jsCode": "// WF-006 — Interpret Export Result\n// provider-gateway returns a normalized {ok,error:{code,message}}\n// envelope, and the HTTP node above is set never to throw so we can\n// actually read it. Re-throwing with a [[CODE]] marker is what\n// lets WF-001 recover the *specific* code: n8n forwards only an\n// error's message string to the parent workflow, so anything the\n// caller needs has to live inside that message. The marker deliberately\n// avoids a colon: n8n parses 'PREFIX: rest' as an error type and throws\n// the prefix away (observed in execution 404).\nconst item = $input.first().json || {};\nconst statusCode = item.statusCode || 200;\nconst body = item.body || {};\nif (statusCode >= 400 || body.ok === false) {\n  const err = body.error || {};\n  const code = err.code || 'UPSTREAM_ERROR';\n  throw new Error('[[' + code + ']] ' + (err.message || 'Playlist export failed.'));\n}\nreturn [{ json: body }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
